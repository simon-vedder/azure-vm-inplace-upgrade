          "variables": {
            "$fxv#0": "{\n  \"version\": \"Notebook/1.0\",\n  \"items\": [\n    {\n      \"type\": 1,\n      \"content\": {\n        \"json\": \"## In-place upgrades\\nOne record per state transition, written by the `AzureInPlaceUpgrade` module through the Logs Ingestion API. The **State** is what the `UpgradeState` tag says; the **Result** is what the job decided.\"\n      },\n      \"name\": \"title\"\n    },\n    {\n      \"type\": 3,\n      \"content\": {\n        \"version\": \"KqlItem/1.0\",\n        \"query\": \"InPlaceUpgrade_CL\\n| summarize arg_max(TimeGenerated, *) by VMName\\n| summarize VMs = count() by State\\n| order by State asc\",\n        \"size\": 4,\n        \"title\": \"VMs by current state\",\n        \"timeContext\": { \"durationMs\": 2592000000 },\n        \"queryType\": 0,\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\",\n        \"crossComponentResources\": [ \"{workspaceId}\" ],\n        \"visualization\": \"tiles\",\n        \"tileSettings\": {\n          \"titleContent\": { \"columnMatch\": \"State\", \"formatter\": 1 },\n          \"leftContent\": { \"columnMatch\": \"VMs\", \"formatter\": 12, \"formatOptions\": { \"palette\": \"auto\" } },\n          \"showBorder\": true\n        }\n      },\n      \"name\": \"states\"\n    },\n    {\n      \"type\": 3,\n      \"content\": {\n        \"version\": \"KqlItem/1.0\",\n        \"query\": \"InPlaceUpgrade_CL\\n| summarize arg_max(TimeGenerated, *) by VMName\\n| project TimeGenerated, VMName, ResourceGroupName, Target, State, Result, SourceBuild, TargetBuild, Engine, ImageIndex, DurationMinutes, TaskResult, Snapshot\\n| order by TimeGenerated desc\",\n        \"size\": 0,\n        \"title\": \"Latest record per VM\",\n        \"timeContext\": { \"durationMs\": 2592000000 },\n        \"queryType\": 0,\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\",\n        \"crossComponentResources\": [ \"{workspaceId}\" ],\n        \"gridSettings\": {\n          \"formatters\": [\n            { \"columnMatch\": \"State\", \"formatter\": 18, \"formatOptions\": { \"thresholdsOptions\": \"colors\", \"thresholdsGrid\": [ { \"operator\": \"==\", \"thresholdValue\": \"Completed\", \"representation\": \"green\", \"text\": \"{0}{1}\" }, { \"operator\": \"==\", \"thresholdValue\": \"Failed\", \"representation\": \"redBright\", \"text\": \"{0}{1}\" }, { \"operator\": \"==\", \"thresholdValue\": \"UpgradeStarted\", \"representation\": \"blue\", \"text\": \"{0}{1}\" }, { \"operator\": \"Default\", \"thresholdValue\": null, \"representation\": \"gray\", \"text\": \"{0}{1}\" } ] } }\n          ]\n        }\n      },\n      \"name\": \"latest\"\n    },\n    {\n      \"type\": 3,\n      \"content\": {\n        \"version\": \"KqlItem/1.0\",\n        \"query\": \"InPlaceUpgrade_CL\\n| where Result == 'Failed' or Result == 'NotEligible'\\n| project TimeGenerated, VMName, Result, Mode, TaskResult, Reason\\n| order by TimeGenerated desc\",\n        \"size\": 0,\n        \"title\": \"Failures and refused preflights\",\n        \"timeContext\": { \"durationMs\": 2592000000 },\n        \"queryType\": 0,\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\",\n        \"crossComponentResources\": [ \"{workspaceId}\" ]\n      },\n      \"name\": \"failures\"\n    },\n    {\n      \"type\": 3,\n      \"content\": {\n        \"version\": \"KqlItem/1.0\",\n        \"query\": \"InPlaceUpgrade_CL\\n| where Result == 'Completed'\\n| project TimeGenerated, VMName, SourceBuild, TargetBuild, DurationMinutes\\n| order by TimeGenerated desc\",\n        \"size\": 0,\n        \"title\": \"Completed upgrades and how long Setup took\",\n        \"timeContext\": { \"durationMs\": 2592000000 },\n        \"queryType\": 0,\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\",\n        \"crossComponentResources\": [ \"{workspaceId}\" ],\n        \"visualization\": \"table\"\n      },\n      \"name\": \"durations\"\n    },\n    {\n      \"type\": 3,\n      \"content\": {\n        \"version\": \"KqlItem/1.0\",\n        \"query\": \"InPlaceUpgrade_CL\\n| summarize Records = count() by bin(TimeGenerated, 15m), Result\\n| order by TimeGenerated asc\",\n        \"size\": 0,\n        \"title\": \"Activity over time\",\n        \"timeContext\": { \"durationMs\": 2592000000 },\n        \"queryType\": 0,\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\",\n        \"crossComponentResources\": [ \"{workspaceId}\" ],\n        \"visualization\": \"barchart\"\n      },\n      \"name\": \"timeline\"\n    }\n  ],\n  \"fallbackResourceIds\": [ \"{workspaceId}\" ],\n  \"$schema\": \"https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json\"\n}\n",
